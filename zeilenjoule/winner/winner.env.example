# ZeilenJoule winner kit — configuration (copied to winner.env by `./kit setup`; secrets are generated there).
# The file is sourced by bash and read by docker compose: KEY=value, no spaces around "=", single quotes for JSON.
# Presets in presets/*.env override the model section; edit winner.env afterwards to use any other local model.

# ------------------------------------------------------------------ how the stack runs
ZJ_MODE=native                # native (no Docker, no sudo) | docker
ZJ_MODEL_SERVER=ollama        # who serves the models:
                              #   vllm-tei  vLLM + TEI as measured (docker mode only)
                              #   ollama    Ollama (native: started by the kit if not running; docker: container)
                              #   llamacpp  two llama-server processes (native mode only)
                              #   external  you run the servers yourself; the kit only checks they answer

# ------------------------------------------------------------------ gateway (HTTP API)
ZJ_BIND=127.0.0.1             # 0.0.0.0 to serve other machines (put a TLS reverse proxy in front)
ZJ_GATEWAY_PORT=8080
ZJ_API_KEYS=                  # comma-separated X-API-Key values; generated by setup when empty
ZJ_RATE_LIMIT=10              # requests/s per key
ZJ_REQUEST_TIMEOUT=300s       # per request (slow CPU-only models need more)

# ------------------------------------------------------------------ database (generated by setup when empty)
POSTGRES_PASSWORD=            # owner role zeilenjoule (hex only: used inside URLs)
ZJ_READER_PASSWORD=           # SELECT-only login zj_ask for the router's SQL
ZJ_PG_SHARED_BUFFERS=1GB      # ~25 % of RAM for large data; 1GB is plenty below 1 M rows

# ------------------------------------------------------------------ chat model (router + answers + labels)
# Any OpenAI-compatible /v1/chat/completions server that supports response_format json_schema.
ZJ_LLM_URL=http://127.0.0.1:11434
ZJ_LLM_MODEL=qwen3:8b
ZJ_LLM_API_KEY=               # sent as Bearer token when set
# Extra top-level request fields, server-specific. Turn "thinking" off, otherwise reasoning models spend the
# token budget before the JSON: vLLM/llama.cpp + Qwen3.x '{"chat_template_kwargs":{"enable_thinking":false}}',
# Ollama '{"reasoning_effort":"none"}', non-reasoning models '{}'.
ZJ_LLM_EXTRA_JSON='{"reasoning_effort":"none"}'
ZJ_LLM_IN_FLIGHT=4            # parallel requests (≤ the server's parallel slots)

# ------------------------------------------------------------------ embedding model
ZJ_EMBED_URL=http://127.0.0.1:11434
ZJ_EMBED_API=openai           # openai (/v1/embeddings: Ollama, llama.cpp, vLLM …) | tei (/embed)
ZJ_EMBED_MODEL=bge-m3
ZJ_EMBED_DIM=1024             # vector size of the model; fixed when the database is created (./kit reset-db to change)
ZJ_EMBED_QUERY_PREFIX=        # e.g. 'query: ' for e5 models, 'search_query: ' for nomic-embed
ZJ_EMBED_DOC_PREFIX=          # e.g. 'passage: ' / 'search_document: '
ZJ_EMBED_IN_FLIGHT=2
ZJ_EMBED_BATCH=64

# ------------------------------------------------------------------ native mode
ZJ_HOME=                      # install + data directory; empty = <kit>/.run
ZJ_PG_PORT=55432              # PostgreSQL on 127.0.0.1 (not the system's 5432)
ZJ_PARSER_THREADS=4
ZJ_WORKER_METRICS=127.0.0.1:9095
ZJ_GATEWAY_METRICS=127.0.0.1:9096

# Ollama (ZJ_MODEL_SERVER=ollama, native): an Ollama already answering at ZJ_LLM_URL is reused as it is.
ZJ_OLLAMA_BIN=                # empty = `ollama` on PATH, else the copy from `./kit setup native --with-ollama`
ZJ_OLLAMA_MODELS=             # model store of a kit-started Ollama; empty = $ZJ_HOME/ollama/models

# llama.cpp (ZJ_MODEL_SERVER=llamacpp, native): ports come from ZJ_LLM_URL / ZJ_EMBED_URL.
ZJ_LLAMA_SERVER_BIN=          # path to llama-server (build: see instruction.md)
ZJ_LLM_GGUF=                  # chat model file
ZJ_EMBED_GGUF=                # embedding model file
ZJ_LLAMA_CHAT_ARGS='-ngl 99 -c 16384 -np 4 --jinja'
ZJ_LLAMA_EMBED_ARGS='-ngl 99 -c 8192 -b 8192 -ub 8192 --pooling cls'

# ------------------------------------------------------------------ docker mode
ZJ_DOCKER_GPU=1               # 0: Ollama container without GPU (CPU-only host); vllm-tei always needs a GPU
ZJ_MODELS_DIR=                # host folder mounted read-only at /models in vLLM/TEI; empty = <kit>/models
# vLLM (profile vllm-tei). A Hugging Face id is downloaded into a volume; a local folder is /models/<sub-folder>.
ZJ_VLLM_MODEL=cyankiwi/Qwen3.5-9B-AWQ-4bit
ZJ_VLLM_ARGS='--revision e4d2d39cede8 --max-model-len 4096 --max-num-seqs 32 --enable-prefix-caching --gpu-memory-utilization 0.70 --limit-mm-per-prompt.image 0 --limit-mm-per-prompt.video 0'
# TEI (profile vllm-tei). The default image is built for RTX 50xx (sm_120); other GPUs: see instruction.md.
ZJ_TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:120-1.9.4@sha256:bd8e5b1954146f7fe8590b64b959bc194433c6c38c036592a84d736841ca9400
ZJ_TEI_MODEL=BAAI/bge-m3
ZJ_TEI_ARGS='--revision 5617a9f61b028005a4858fdac845db406aefb181 --dtype float16 --max-batch-tokens 16384 --max-client-batch-size 256 --auto-truncate true'
