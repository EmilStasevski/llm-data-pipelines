# llama.cpp: two llama-server processes started by the kit (native mode). Set the binary and both GGUF files.
# bge-m3 GGUF uses CLS pooling (ZJ_LLAMA_EMBED_ARGS); mean-pooling models need --pooling mean.
ZJ_MODEL_SERVER=llamacpp
ZJ_LLM_URL=http://127.0.0.1:8000
ZJ_LLM_MODEL=chat
ZJ_LLM_EXTRA_JSON='{"chat_template_kwargs":{"enable_thinking":false}}'
ZJ_LLM_IN_FLIGHT=4
ZJ_EMBED_URL=http://127.0.0.1:8081
ZJ_EMBED_API=openai
ZJ_EMBED_MODEL=embed
ZJ_EMBED_DIM=1024
ZJ_EMBED_IN_FLIGHT=2
ZJ_EMBED_BATCH=64
ZJ_REQUEST_TIMEOUT=300s
ZJ_LLAMA_SERVER_BIN=
ZJ_LLM_GGUF=
ZJ_EMBED_GGUF=
