# The measured winner (e06_stack_go, ADR 0021/0027): vLLM serves Qwen3.5-9B AWQ, TEI serves bge-m3, both on one GPU.
# Docker mode only (TEI has no no-Docker build). Needs an NVIDIA GPU with ≥ 16 GB and the NVIDIA Container Toolkit.
ZJ_MODEL_SERVER=vllm-tei
ZJ_LLM_URL=http://vllm:8000
ZJ_LLM_MODEL=model
ZJ_LLM_EXTRA_JSON='{"chat_template_kwargs":{"enable_thinking":false}}'
ZJ_LLM_IN_FLIGHT=32
ZJ_EMBED_URL=http://tei:8081
ZJ_EMBED_API=tei
ZJ_EMBED_MODEL=bge-m3
ZJ_EMBED_DIM=1024
ZJ_EMBED_IN_FLIGHT=4
ZJ_EMBED_BATCH=128
ZJ_REQUEST_TIMEOUT=120s
