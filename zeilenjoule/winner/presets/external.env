# Bring your own servers: any OpenAI-compatible chat endpoint with json_schema output (vLLM, SGLang, LM Studio,
# llama.cpp, Ollama, LocalAI …) and any /v1/embeddings (or TEI /embed) endpoint. Fill in URLs, names and the size.
# In docker mode, 127.0.0.1/localhost URLs are rewritten to host.docker.internal (the host).
ZJ_MODEL_SERVER=external
ZJ_LLM_URL=http://127.0.0.1:8000
ZJ_LLM_MODEL=
ZJ_LLM_EXTRA_JSON='{}'
ZJ_LLM_IN_FLIGHT=8
ZJ_EMBED_URL=http://127.0.0.1:8081
ZJ_EMBED_API=openai
ZJ_EMBED_MODEL=
ZJ_EMBED_DIM=1024
ZJ_EMBED_IN_FLIGHT=2
ZJ_EMBED_BATCH=64
ZJ_REQUEST_TIMEOUT=300s
