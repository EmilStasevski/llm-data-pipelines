# Ollama: easiest way to try any local model (GPU or CPU). Default models: qwen3:8b (chat) + bge-m3 (embeddings).
# Other models: change ZJ_LLM_MODEL / ZJ_EMBED_MODEL (+ ZJ_EMBED_DIM), the kit pulls them on start.
ZJ_MODEL_SERVER=ollama
ZJ_LLM_URL=http://127.0.0.1:11434
ZJ_LLM_MODEL=qwen3:8b
ZJ_LLM_EXTRA_JSON='{"reasoning_effort":"none"}'
ZJ_LLM_IN_FLIGHT=4
ZJ_EMBED_URL=http://127.0.0.1:11434
ZJ_EMBED_API=openai
ZJ_EMBED_MODEL=bge-m3
ZJ_EMBED_DIM=1024
ZJ_EMBED_IN_FLIGHT=2
ZJ_EMBED_BATCH=64
ZJ_REQUEST_TIMEOUT=300s
