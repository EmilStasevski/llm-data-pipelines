{
  "include": [
    "src",
    "tests"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "//": "Wraps native libs without type stubs (faiss / lancedb / cuvs …): unknown-type rules are warnings here only (ADR 0005).",
  "reportMissingTypeStubs": "none",
  "reportUnknownMemberType": "warning",
  "reportUnknownVariableType": "warning",
  "reportUnknownArgumentType": "warning"
}
