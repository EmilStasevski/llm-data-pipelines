# Copy to .env (gitignored, rule 10) and fill in only what you need. Nothing here is required for Phase 1.

# Hugging Face token: only for gated models (e.g. google/embeddinggemma-300m). Read-only scope is enough.
HF_TOKEN=

# Optional wall-power meter (checklist C11), mirrors config/bench.yaml energy.wall_meter
ZJ_WALL_METER_URL=

# Phase 6: database containers (local only, never reused elsewhere)
POSTGRES_PASSWORD=change-me-local-only

# Phase 9: gateway API key for local testing
ZJ_API_KEY=
