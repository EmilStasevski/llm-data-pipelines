# Copy to .env (gitignored, rule 10) and fill in only what you need. Nothing here is required for Phase 1.

# Hugging Face token: only for gated models (e.g. google/embeddinggemma-300m). Read-only scope is enough.
HF_TOKEN=

# Optional wall-power meter (checklist C11), mirrors config/bench.yaml energy.wall_meter
ZJ_WALL_METER_URL=

# Phase 6: database containers (local only, never reused elsewhere)
POSTGRES_PASSWORD=change-me-local-only

# Phase 9: production stack (deploy/compose, `task up`). Use long random values, e.g. `openssl rand -hex 24`.
# POSTGRES_PASSWORD above is also the owner password of the stack's database.
ZJ_READER_PASSWORD=change-me-local-only
# comma-separated; clients send one of them as X-API-Key
ZJ_API_KEYS=change-me-local-only
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# uid/gid the model servers run as (must be able to read models/ and write models/cache/vllm): `id -u`, `id -g`
ZJ_UID=1000
ZJ_GID=1000
# optional overrides: requests/s per API key, model servers outside the compose stack
# ZJ_RATE_LIMIT=10
# ZJ_TEI_URL=http://tei:8081
# ZJ_LLM_URL=http://vllm:8000
